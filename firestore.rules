rules_version = '2';

// The desk's records are written only by psd-agents, whose server credentials these rules do not govern. The pages
// only listen: a coordinator to incidents and tasks, a store page to its own store's tasks. Everything else is closed.
service cloud.firestore {
  match /databases/{database}/documents {
    function coordinator() {
      return request.auth != null && request.auth.token.coordinator == true;
    }

    match /psd_incidents/{incident} {
      allow read: if coordinator();
    }

    match /psd_tasks/{task} {
      allow read: if coordinator()
        || (request.auth != null && request.auth.token.store_id == resource.data.store_id);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
