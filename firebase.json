{
  "hosting": {
    "public": "api/static",
    "cleanUrls": true,
    "rewrites": [
      { "source": "/desk/api/**", "run": { "serviceId": "psd-api", "region": "us-central1" } },
      { "source": "/store/api/**", "run": { "serviceId": "psd-api", "region": "us-central1" } },
      { "source": "/metrics", "run": { "serviceId": "psd-api", "region": "us-central1" } },
      { "source": "/", "destination": "/desk.html" }
    ],
    "headers": [
      { "source": "**/*.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/desk", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/store", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
